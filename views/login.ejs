<%- include("partials/head") %>
<%- include("partials/nav") %>

<main class="container">
  <%- include("partials/flash") %>

  <section class="panel login-panel">
    <h1>Sign in</h1>
    <p class="muted">Use your college student account to register for courses.</p>

    <% if (error) { %>
      <div class="flash flash-error" role="alert"><%= error %></div>
    <% } %>

    <form method="post" action="/login" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= next %>">

      <div class="form-row">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" required value="<%= email %>" autofocus>
      </div>

      <div class="form-row">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>

      <button class="button primary" type="submit">Sign in</button>
    </form>

    <% if (showDemo) { %>
      <div class="demo-note">
        <p class="muted"><strong>Demo students</strong></p>
        <p class="muted">alice@college.edu / Student123!</p>
        <p class="muted">bob@college.edu / Student123!</p>
      </div>
    <% } %>
  </section>
</main>

<%- include("partials/footer") %>
